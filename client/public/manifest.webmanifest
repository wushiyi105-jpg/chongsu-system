{
  "name": "重塑系统",
  "short_name": "重塑",
  "description": "人生目标与知识碎片管理系统",
  "start_url": "./?utm_source=pwa",
  "scope": "./",
  "id": "/?utm_source=pwa",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#f2f2f0",
  "theme_color": "#f2f2f0",
  "orientation": "portrait",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing",
    "route_to": "auto"
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
