# ============================================================
# 重塑系统 · 环境变量配置模板
# 复制为 .env 后填入实际值，切勿提交真实密钥到版本库
# ============================================================

# --- 数据库 ---
# PostgreSQL 连接字符串（必填）
# 格式: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chongsu

# --- 鉴权 ---
# JWT 签名密钥，生产环境务必设置为强随机字符串
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# JWT Token 有效期（默认 30 天）
JWT_EXPIRES_IN=30d

# 开发模式万能登录码
# 设置后可跳过真实短信验证，直接用该码登录；生产环境务必留空或删除
LOGIN_CODE=changeme

# --- 第三方服务（可选）---
# TikHub API Key（用于抖音链接解析，不填则该功能降级）
# 申请地址: https://tikhub.io
TIKHUB_API_KEY=

# --- 服务配置 ---
# 后端监听端口
PORT=3000

# --- 日志 ---
# 日志目录（相对路径）
LOG_DIR=./logs

# 是否记录请求/响应体（调试用，生产环境建议关闭）
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true
