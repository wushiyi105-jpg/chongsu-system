{
  "id": "image_ocr_text_extraction_1",
  "pluginKey": "@official-plugins/ai-image-understanding",
  "pluginVersion": "1.0.22",
  "name": "图片文字识别OCR",
  "description": "对用户上传的单张图片进行文字提取，输出图片中的纯文本内容，保持原文段落和换行结构。",
  "icon": "",
  "paramsSchema": {
    "type": "object",
    "properties": {
      "upload_image": {
        "type": "array",
        "format": "plugin-image-url",
        "description": "待识别文字的单张图片",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "upload_image"
    ]
  },
  "formValue": {
    "images": "{{input.upload_image}}",
    "modelID": "2015",
    "modelParams": {
      "maxTokens": 8192,
      "temperature": 0.5
    },
    "prompt": "请识别并提取图片中的所有文字内容，保持原文的段落和换行结构，不要添加任何解释、说明或总结性文字，只输出图片中的文字本身。如果图片中没有文字，输出\"（无文字）\"。"
  },
  "createdAt": 0,
  "updatedAt": 0,
  "createdBy": 0,
  "_note": "平台元数据（时间戳/创建者）已在开源时脱敏"
}